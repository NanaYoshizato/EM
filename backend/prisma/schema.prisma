generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EmployeeStatus {
  WORKING
  WAITING
  TRAINING
  BEFORE_JOIN
  LEAVE
}

enum Specialty {
  FE
  BE
  UNDECIDED
}

// 稼働ステータス（社員ごとに入力する。値は用語集の就業ステータスに内勤を加えたもの）
enum WorkStatus {
  WORKING // 稼働中
  WAITING // 待機中
  TRAINING // 研修中
  IN_OFFICE // 内勤
  BEFORE_JOIN // 入社前
  LEAVE // 契約終了
}

enum SkillCategory {
  LANGUAGE
  LIBRARY
  FRAMEWORK
  CLOUD
  OTHER
}

enum SettlementUnit {
  MIN_1
  MIN_10
  MIN_15
  MIN_30
  MIN_60
}

model User {
  id          Int    @id @default(autoincrement())
  email       String @unique
  firebaseUid String @unique @map("firebase_uid")

  roleId Int  @default(5) @map("role_id")
  role   Role @relation(fields: [roleId], references: [id])

  isDelete  Boolean  @default(false) @map("is_delete")
  createrId String?  @map("creater_id")
  createdAt DateTime @default(now()) @map("created_at")
  updaterId String?  @map("updater_id")
  updatedAt DateTime @updatedAt @map("updated_at")

  employee    Employee?
  assignments ProjectAssignment[]

  @@map("user")
}

// 権限マスタ (権限の強い順: 1: 管理者 / 2: システム管理者 / 3: 営業担当 / 4: メンター / 5: 一般社員)
model Role {
  id    Int    @id
  name  String @unique @map("name")
  label String @map("label")

  users User[]

  isDelete  Boolean  @default(false) @map("is_delete")
  createrId String?  @map("creater_id")
  createdAt DateTime @default(now()) @map("created_at")
  updaterId String?  @map("updater_id")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("role")
}

// 社員
model Employee {
  id           Int    @id @default(autoincrement())
  employeeCode String @unique @map("employee_code")
  userId       Int?   @unique @map("user_id")
  user         User?  @relation(fields: [userId], references: [id])

  name      String    @map("name") @db.VarChar(30)
  furigana  String?   @map("furigana") @db.VarChar(30)
  email     String?   @unique @map("email")
  birthDate DateTime? @map("birth_date")
  gender    Gender?   @map("gender")
  phone     String?   @map("phone")

  joinDate         DateTime?                @map("join_date")
  specialty        Specialty                @default(UNDECIDED) @map("specialty")
  workStatus       WorkStatus               @default(WAITING) @map("work_status")
  gitHub           String?                  @map("git_hub") @db.VarChar(39)
  trainingEndDate  DateTime?                @map("training_end_date")
  employeeSkills   EmployeeSkill[]
  projectHistories EmployeeProjectHistory[]

  previousCompany1Name      String?   @map("previous_company1_name") @db.VarChar(100) // 前職の情報
  previousCompany1StartDate DateTime? @map("previous_company1_start_date")
  previousCompany1EndDate   DateTime? @map("previous_company1_end_date")
  previousCompany2Name      String?   @map("previous_company2_name") @db.VarChar(100)
  previousCompany2StartDate DateTime? @map("previous_company2_start_date")
  previousCompany2EndDate   DateTime? @map("previous_company2_end_date")
  previousCompany3Name      String?   @map("previous_company3_name") @db.VarChar(100)
  previousCompany3StartDate DateTime? @map("previous_company3_start_date")
  previousCompany3EndDate   DateTime? @map("previous_company3_end_date")

  weeklyWorkHours        String? @map("weekly_work_hours") @db.VarChar(20)
  monthlyEstimatedSalary Int?    @map("monthly_estimated_salary")

  postalCode     String? @map("postal_code")
  prefecture     String? @map("prefecture") @db.VarChar(10)
  city           String? @map("city") @db.VarChar(100)
  streetAddress  String? @map("street_address") @db.VarChar(100)
  nearestStation String? @map("nearest_station")

  emergencyContactName         String? @map("emergency_contact_name") @db.VarChar(50) // 緊急連絡先
  emergencyContactRelationship String? @map("emergency_contact_relationship") @db.VarChar(20)
  emergencyContactPhone        String? @map("emergency_contact_phone")

  hasSpouse     Boolean? @map("has_spouse")
  hasChildren   Boolean? @map("has_children")
  hasDependents Boolean? @map("has_dependents")

  myNumber                  String? @unique @map("my_number")
  employmentInsuranceNumber String? @map("employment_insurance_number")
  basicPensionNumber        String? @map("basic_pension_number")
  salaryAccount             String? @map("salary_account") @db.VarChar(100)

  assignments ProjectAssignment[]

  isDelete  Boolean  @default(false) @map("is_delete")
  createrId String?  @map("creater_id")
  createdAt DateTime @default(now()) @map("created_at")
  updaterId String?  @map("updater_id")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@index([employeeCode])
  @@map("employee")
}

// 案件
model Project {
  id                Int     @id @default(autoincrement())
  name              String  @map("name")
  clientCompanyName String? @map("client_company_name")
  clientAddress     String? @map("client_address")

  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")

  minWorkHours Int? @map("min_work_hours")
  maxWorkHours Int? @map("max_work_hours")

  excessUnitPrice    Int? @map("excess_unit_price") // 超過単価
  deductionUnitPrice Int? @map("deduction_unit_price") // 控除単価

  settlementUnit SettlementUnit? @map("settlement_unit")

  minPrice Int? @map("min_price")
  maxPrice Int? @map("max_price")

  workStyle      String? @map("work_style")
  nearestStation String? @map("nearest_station")

  remarks String? @map("remarks")

  isDelete  Boolean  @default(false) @map("is_delete")
  createrId String?  @map("creater_id")
  createdAt DateTime @default(now()) @map("created_at")
  updaterId String?  @map("updater_id")
  updatedAt DateTime @updatedAt @map("updated_at")

  assignments ProjectAssignment[]

  @@map("project")
}

// 案件 × 社員
model ProjectAssignment {
  id         Int @id @default(autoincrement())
  projectId  Int @map("project_id")
  employeeId Int @map("employee_id")

  project  Project  @relation(fields: [projectId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  status EmployeeStatus

  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")

  contractPrice      Int? @map("contract_price") // 契約単価（最新の単価。履歴はcontractsを参照）
  excessUnitPrice    Int? @map("excess_unit_price") // 超過単価
  deductionUnitPrice Int? @map("deduction_unit_price") // 控除単価

  remarks String? @map("remarks")

  mentorId Int?  @map("mentor_id")
  mentor   User? @relation(fields: [mentorId], references: [id])

  contracts ProjectAssignmentContract[]

  isDelete  Boolean  @default(false) @map("is_delete")
  createrId String?  @map("creater_id")
  createdAt DateTime @default(now()) @map("created_at")
  updaterId String?  @map("updater_id")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([projectId, employeeId])
  @@index([status])
  @@map("project_assignment")
}

// 案件アサインの単価改定履歴（フロントの案件履歴画面がcontracts[]として複数件保持する前提に合わせた構造）
model ProjectAssignmentContract {
  id                  Int @id @default(autoincrement())
  projectAssignmentId Int @map("project_assignment_id")

  projectAssignment ProjectAssignment @relation(fields: [projectAssignmentId], references: [id])

  startDate DateTime @map("start_date") // この単価の適用開始日
  unitPrice Int      @map("unit_price")

  isDelete  Boolean  @default(false) @map("is_delete")
  createrId String?  @map("creater_id")
  createdAt DateTime @default(now()) @map("created_at")
  updaterId String?  @map("updater_id")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([projectAssignmentId])
  @@map("project_assignment_contract")
}

// スキル(スキル選択肢一覧取得で使用)
model Skill {
  id       Int           @id @default(autoincrement())
  name     String        @unique @map("name")
  category SkillCategory @map("category")

  isDelete  Boolean  @default(false) @map("is_delete")
  createrId String?  @map("creater_id")
  createdAt DateTime @default(now()) @map("created_at")
  updaterId String?  @map("updater_id")
  updatedAt DateTime @updatedAt @map("updated_at")

  employeeSkills       EmployeeSkill[]
  projectHistorySkills EmployeeProjectHistorySkill[]

  @@map("skill")
}

// スキル × 社員
model EmployeeSkill {
  id         Int   @id @default(autoincrement())
  employeeId Int   @map("employee_id")
  skillId    Int   @map("skill_id")
  ///経験年数
  years      Float @map("years")

  employee Employee @relation(fields: [employeeId], references: [id])
  skill    Skill    @relation(fields: [skillId], references: [id])

  ///削除フラグ
  isDelete  Boolean  @default(false) @map("is_delete")
  createrId String?  @map("creater_id")
  createdAt DateTime @default(now()) @map("created_at")
  updaterId String?  @map("updater_id")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([employeeId, skillId])
  @@map("employee_skill")
}

// 案件履歴
model EmployeeProjectHistory {
  id          Int       @id @default(autoincrement())
  employeeId  Int       @map("employee_id")
  active      Boolean   @map("active")
  projectName String    @map("project_name") @db.VarChar(100)
  factory     String    @map("factory") @db.VarChar(100)
  startDate   DateTime  @map("start_date")
  endDate     DateTime? @map("end_date")

  employee  Employee                      @relation(fields: [employeeId], references: [id])
  skills    EmployeeProjectHistorySkill[]
  contracts EmployeeProjectContract[]

  isDelete  Boolean  @default(false) @map("is_delete")
  createrId String?  @map("creater_id")
  createdAt DateTime @default(now()) @map("created_at")
  updaterId String?  @map("updater_id")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("employee_project_history")
}

// 社員履歴 × スキル
model EmployeeProjectHistorySkill {
  id               Int @id @default(autoincrement())
  projectHistoryId Int @map("project_history_id")
  skillId          Int @map("skill_id")

  projectHistory EmployeeProjectHistory @relation(fields: [projectHistoryId], references: [id])
  skill          Skill                  @relation(fields: [skillId], references: [id])

  isDelete  Boolean  @default(false) @map("is_delete")
  createrId String?  @map("creater_id")
  createdAt DateTime @default(now()) @map("created_at")
  updaterId String?  @map("updater_id")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([projectHistoryId, skillId])
  @@map("employee_project_history_skill")
}

// 社員履歴 × 単価履歴
model EmployeeProjectContract {
  id               Int      @id @default(autoincrement())
  projectHistoryId Int      @map("project_history_id")
  startDate        DateTime @map("start_date")
  unitPrice        Int?     @map("unit_price")

  projectHistory EmployeeProjectHistory @relation(fields: [projectHistoryId], references: [id])

  isDelete  Boolean  @default(false) @map("is_delete")
  createrId String?  @map("creater_id")
  createdAt DateTime @default(now()) @map("created_at")
  updaterId String?  @map("updater_id")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("employee_project_contract")
}
