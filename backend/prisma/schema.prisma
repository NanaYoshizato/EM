generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EmployeeStatus {
  WORKING
  WAITING
  TRAINING
  BEFORE_JOIN
  LEAVE
}

enum SettlementUnit {
  MIN_1
  MIN_10
  MIN_15
  MIN_30
  MIN_60
}

model User {
  id        Int  @id @default(autoincrement())
  email     String @unique
  password  String

  isDelete  Boolean @default(false) @map("is_delete")
  createrId String? @map("creater_id")
  createdAt DateTime @default(now()) @map("created_at")
  updaterId String? @map("updater_id")
  updatedAt DateTime @updatedAt @map("updated_at")

  employee     Employee?
  assignments  ProjectAssignment[]

  @@map("user")
}

model Employee {
  id                        Int                    @id @default(autoincrement())
  employeeCode              String                 @unique @map("employee_code")
  userId                    Int                 @unique @map("user_id")
  user                      User?                  @relation(fields: [userId], references: [id])

  name                      String                 @map("name")
  furigana                  String?                @map("furigana")
  email                     String?                @map("email")
  birthDate                 DateTime?              @map("birth_date")
  gender                    Gender?                 @map("gender")
  phone                     String?                @map("phone")

  joinDate                  DateTime?              @map("join_date")
  trainingEndDate           DateTime?              @map("training_end_date")
  studiedFrameworks         EmployeeStudiedFramework[]
  availableFrameworks       EmployeeAvailableFramework[]

  previousCompany1Name      String?                @map("previous_company1_name")  // 前職の情報
  previousCompany1StartDate DateTime?              @map("previous_company1_start_date")
  previousCompany1EndDate   DateTime?              @map("previous_company1_end_date")
  previousCompany2Name      String?                @map("previous_company2_name")
  previousCompany2StartDate DateTime?              @map("previous_company2_start_date")
  previousCompany2EndDate   DateTime?              @map("previous_company2_end_date")
  previousCompany3Name      String?                @map("previous_company3_name")
  previousCompany3StartDate DateTime?              @map("previous_company3_start_date")
  previousCompany3EndDate   DateTime?              @map("previous_company3_end_date")

  weeklyWorkHours           String?                @map("weekly_work_hours")
  monthlyEstimatedSalary    Int?                   @map("monthly_estimated_salary")

  postalCode                String?                @map("postal_code")
  prefecture                String?                @map("prefecture")
  city                      String?                @map("city")
  streetAddress             String?                @map("street_address")
  nearestStation            String?                @map("nearest_station")

  emergencyContactName         String?             @map("emergency_contact_name")  // 緊急連絡先
  emergencyContactRelationship String?             @map("emergency_contact_relationship")
  emergencyContactPhone        String?             @map("emergency_contact_phone")

  hasSpouse                 Boolean?                @map("has_spouse")
  hasChildren               Boolean?                @map("has_children")
  hasDependents             Boolean?                @map("has_dependents")

  myNumber                  String?                @unique @map("my_number")
  employmentInsuranceNumber String?                @map("employment_insurance_number")
  basicPensionNumber        String?                @map("basic_pension_number")
  salaryAccount             String?                @map("salary_account")

  assignments               ProjectAssignment[]

  isDelete                  Boolean                @default(false) @map("is_delete")
  createrId                 String?                @map("creater_id")
  createdAt                 DateTime               @default(now()) @map("created_at")
  updaterId                 String?                @map("updater_id")
  updatedAt                 DateTime               @updatedAt @map("updated_at")

  @@index([name])
  @@index([employeeCode])
  @@map("employee")
}

model Framework {
  id            Int                        @id @default(autoincrement())
  frameworkName String                     @unique @map("framework_name")

  isDelete      Boolean                    @default(false) @map("is_delete")
  createrId     String?                    @map("creater_id")
  createdAt     DateTime                   @default(now()) @map("created_at")
  updaterId     String?                    @map("updater_id")
  updatedAt     DateTime                   @updatedAt @map("updated_at")

  studiedBy         EmployeeStudiedFramework[]
  availableBy       EmployeeAvailableFramework[]
  projectFrameworks ProjectFramework[]
  assignmentFrameworks ProjectAssignmentFramework[]

  @@map("framework")
}

// 研修中言語
model EmployeeStudiedFramework {
  id           Int        @id @default(autoincrement())
  employeeId   Int        @map("employee_id")
  frameworkId  Int        @map("framework_id")

  employee     Employee   @relation(fields: [employeeId], references: [id])
  framework    Framework  @relation(fields: [frameworkId], references: [id])

  isDelete     Boolean    @default(false) @map("is_delete")
  createrId    String?    @map("creater_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updaterId    String?    @map("updater_id")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@unique([employeeId, frameworkId])
  @@map("employee_studied_framework")
}

// 利用可能言語
model EmployeeAvailableFramework {
  id           Int        @id @default(autoincrement())
  employeeId   Int     @map("employee_id")
  frameworkId  Int     @map("framework_id")

  employee     Employee   @relation(fields: [employeeId], references: [id])
  framework    Framework  @relation(fields: [frameworkId], references: [id])

  isDelete     Boolean    @default(false) @map("is_delete")
  createrId    String?    @map("creater_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updaterId    String?    @map("updater_id")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@unique([employeeId, frameworkId])
  @@map("employee_available_framework")
}

// 案件
model Project {
  id                Int                      @id @default(autoincrement())
  name              String                   @map("name")
  clientCompanyName String?                  @map("client_company_name")
  clientAddress     String?                  @map("client_address")

  startDate         DateTime?                @map("start_date")
  endDate           DateTime?                @map("end_date")

  minWorkHours      Int?                     @map("min_work_hours")
  maxWorkHours      Int?                     @map("max_work_hours")

  excessUnitPrice    Int?                    @map("excess_unit_price") // 超過単価
  deductionUnitPrice Int?                    @map("deduction_unit_price") // 控除単価

  settlementUnit    SettlementUnit?          @map("settlement_unit")

  minPrice          Int?                     @map("min_price")
  maxPrice          Int?                     @map("max_price")

  workStyle         String?                  @map("work_style")
  nearestStation    String?                  @map("nearest_station")

  remarks           String?                  @map("remarks")

  isDelete          Boolean                  @default(false) @map("is_delete")
  createrId         String?                  @map("creater_id")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updaterId         String?                  @map("updater_id")
  updatedAt         DateTime                 @updatedAt @map("updated_at")

  assignments       ProjectAssignment[]
  framework         ProjectFramework[]

  @@map("project")
}

// 案件 × 言語
model ProjectFramework {
  id                 Int       @id @default(autoincrement())
  projectId          Int    @map("project_id")
  frameworkId        Int    @map("framework_id")

  project            Project   @relation(fields: [projectId], references: [id])
  framework          Framework @relation(fields: [frameworkId], references: [id])

  isDelete           Boolean   @default(false) @map("is_delete")
  createrId          String?   @map("creater_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updaterId          String?   @map("updater_id")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@unique([projectId, frameworkId])
  @@map("project_framework")
}

// 案件 × 社員
model ProjectAssignment {
  id                  Int              @id @default(autoincrement())
  projectId           Int              @map("project_id")
  employeeId          Int              @map("employee_id")

  project             Project          @relation(fields: [projectId], references: [id])
  employee            Employee         @relation(fields: [employeeId], references: [id])

  status              EmployeeStatus

  startDate           DateTime?        @map("start_date")
  endDate             DateTime?        @map("end_date")

  contractPrice       Int?             @map("contract_price") // 契約単価
  excessUnitPrice     Int?             @map("excess_unit_price") // 超過単価
  deductionUnitPrice  Int?             @map("deduction_unit_price") // 控除単価

  remarks             String?          @map("remarks")

  mentorId            Int?             @map("mentor_id")
  mentor              User?            @relation(fields: [mentorId], references: [id])

  frameworks          ProjectAssignmentFramework[]

  isDelete            Boolean          @default(false) @map("is_delete")
  createrId           String?          @map("creater_id")
  createdAt           DateTime         @default(now()) @map("created_at")
  updaterId           String?          @map("updater_id")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  @@unique([projectId, employeeId])
  @@index([status])
  @@map("project_assignment")
}

// 案件アサイン × 言語 (社員がその案件で使う言語)
model ProjectAssignmentFramework {
  id                  Int                @id @default(autoincrement())
  projectAssignmentId Int                @map("project_assignment_id")
  frameworkId         Int                @map("framework_id")

  projectAssignment   ProjectAssignment  @relation(fields: [projectAssignmentId], references: [id])
  framework           Framework          @relation(fields: [frameworkId], references: [id])

  isDelete            Boolean            @default(false) @map("is_delete")
  createrId           String?            @map("creater_id")
  createdAt           DateTime           @default(now()) @map("created_at")
  updaterId           String?            @map("updater_id")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  @@unique([projectAssignmentId, frameworkId])
  @@map("project_assignment_framework")
}
